# Secrets & local config
.env
.env.local
# Any local variant or backup — these hold real credentials. Matches .env.bak-*,
# .env.save, backend/.env, etc. `.env.example` is force-tracked below.
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
# Coverage output: `.coverage` is the binary data file, htmlcov/ the rendered report.
.coverage
.coverage.*
coverage.xml
htmlcov/
# Pins one local interpreter version — whoever clones next has their own.
.python-version
*.db
agentcraft.db
# Same thing under the other two extensions SQLite is written with. The dev database is
# seeded on API startup (super admin included), so a committed copy is never needed and
# would ship one machine's users and workspaces to everyone who cloned.
*.sqlite
*.sqlite3

# Node / Angular
node_modules/
frontend/dist/
frontend/.angular/
# Unanchored as well as the path above: `ng` writes its build cache relative to the working
# directory, so running it from the repo root instead of frontend/ puts .angular/ there.
.angular/
# TypeScript incremental build cache — one per tsconfig, regenerated on every build.
*.tsbuildinfo
.eslintcache
coverage/
# Generated from .env by frontend/scripts/write-env.cjs on every start/build.
# Not committed: .env is the source of truth, and a checked-in copy would let a stale
# port ship to whoever cloned next.
frontend/src/environments/environment.ts
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / OS
.idea/
.vscode/
.fleet/
*.sublime-workspace
*.swp
*~
# Claude Code's per-machine overrides only. `.claude/` itself is deliberately NOT ignored —
# project agents, skills and rules belong in the repo; this one file is the local opt-out.
.claude/settings.local.json
# Left behind by a conflicted merge or a failed `git apply`. Committing a .orig is how one
# person's conflict resolution becomes everybody's source file.
*.orig
*.rej
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Exports / uploads
uploads/
exports/
*.zip
# Rendered blueprint PNGs — a cache of the stored diagram set, re-rendered on demand
# (the filename carries RENDER_REVISION, so a stale one is never served).
#
# Anchored with a leading slash, and both locations listed, because the cache root is
# `Path("diagrams")` relative to the working directory — the repo root when the API is
# started with `./backend/run_api.sh`, or `backend/` when started from inside it. A bare
# `diagrams/` would also match `backend/app/services/diagrams/`, quietly leaving the whole
# renderer package out of every commit.
/diagrams/
/backend/diagrams/
# The CLI's default --out for `diagrams save` / `diagrams generate`.
/blueprint/

# Client-facing documents, and the scripts that build and check them
#
# Deliverables about the product rather than part of it: nothing in backend/, frontend/ or cli/
# imports, reads or serves any of these, and the app builds and runs with all of them absent.
# They also version badly — the .pdf and .docx are opaque binaries no diff can review, and
# build-client-document.py carries the whole document inline, so a wording tweak reads as a
# 130 KB source change.
#
# Anchored with a leading slash: these live at the repo root, and an unanchored `*.html` or
# `*.pdf` would also swallow legitimate files elsewhere (frontend templates, test fixtures).
/build-client-document.py
/verify-client-document.py
/Agent Craft documentation.md
/Agent Craft documentation (annotated).md
/AgentCraft - Capability Assessment (Client).docx
/AgentCraft - Capability Assessment (Client).html
/AgentCraft-Documentation-Feasibility.html
/AgentCraft-Studio-UserManual.pdf

# CLI local state
.agentcraft/

# Local runtime state — this stack's own scratch, all of it regenerated on demand
#
# PIDs from run-tmux.sh / run_api.sh. A committed one is worse than none: it names a process
# on somebody else's machine, and whatever reads it next would act on a PID it does not own.
*.pid
nohup.out
# Scratch from manual runs against a live API — a project id from one test, the plan JSON it
# generated. `.last_test_project_id.txt` and `.last_fleetpulse_plan.json` arrived this way in
# the first commit and nothing has read them since; no code refers to either name.
.last_*
# Where `backend/scripts/_arch_sample.py` drops the three architectural views for eyeballing.
# Renders, not source: a diagram change is reviewed by looking at the PNG, and the PNG is
# regenerated by re-running the script.
.scratch/
